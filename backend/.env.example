# ─── Homecare API environment ───────────────────────────────────────────────
# Copy to .env for local development. Never commit .env.
# The server validates every value at boot (src/config/env.ts) and refuses unsafe settings.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker-compose.yml starts one on port 5433)
# Production requires verified TLS: ...?sslmode=verify-full  (+ &sslrootcert=/certs/ca.crt for a private CA)
DATABASE_URL="postgresql://homecare:homecare_dev@localhost:5433/homecare?schema=public"
# Migrations only (prisma migrate deploy). Optional locally (falls back to DATABASE_URL). Production format:
#   postgresql://MIGRATOR:PASS@HOST:5432/DB?sslmode=require&sslaccept=strict  (+ &sslcert=/certs/ca.crt)
# MIGRATION_DATABASE_URL=

# Secrets: at least 32 random characters each, and different from each other.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-different-long-random-secret

# Token lifetimes (customers)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Staff (admin dashboard): shorter, non-sliding sessions
ADMIN_ACCESS_TOKEN_TTL_SECONDS=600
ADMIN_SESSION_TTL_HOURS=12

# One-time passwords
#   console = DEVELOPMENT ONLY: codes are printed in the server terminal (refused when NODE_ENV=production)
#   none    = no SMS provider: sending a code returns 503 (honest failure)
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Global per-IP request budget per minute (auth routes have tighter limits)
RATE_LIMIT_PER_MINUTE=120

# Browser origins allowed by CORS (comma-separated, credentials allowed). The native apps don't need CORS;
# the Expo web previews (customer 8081, Pro 8082) and the admin dashboard (3001) do.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:3001

# Number of reverse proxies in front of the API (false = 0, true = 1; e.g. 2 for CDN -> load balancer).
# Never more than the real number: extra hops let clients spoof their IP.
TRUST_PROXY=false

# Swagger UI at /docs (defaults to on outside production)
# SWAGGER_ENABLED=true

# Background scheduler (day-before reminders). Safe on multiple instances: jobs are claimed in PostgreSQL.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
