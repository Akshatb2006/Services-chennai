# Homecare API base URL (no trailing slash). Leave empty to run without a backend:
# browsing works, and anything needing an account shows an honest "not connected" message.
#   iOS simulator / web preview:  http://localhost:4000
#   Android emulator:             http://10.0.2.2:4000
#   Physical device (same Wi-Fi): http://<your-computer-LAN-IP>:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Public website (privacy policy, terms). Placeholder until the real domain is set.
EXPO_PUBLIC_WEB_URL=https://homecare.example.com
