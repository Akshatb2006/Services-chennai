{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@homecare/catalog": [
        "../../catalog/src/index.ts"
      ],
      "@homecare/design-system": [
        "../../design-system/dist/tokens"
      ],
      "@homecare/contracts": [
        "../../contracts/src/index.ts"
      ],
      "zod": [
        "./node_modules/zod"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
